APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Player SMS reset. "none" sends nothing. Use "http" only after a provider is approved.
SMS_DRIVER=none
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# Value the shared-password check compares against. Leave empty to turn
# that check off. Seeders that must store it refuse to run until it is set.
# Do not commit a value. Deploy does not change passwords.
NUVRA_SHARED_DEFAULT_PASSWORD=

# Comma-separated known-weak list for the admin forced-change check.
# Leave empty to turn that check off. Do not commit values.
NUVRA_WEAK_PASSWORDS=

# Shared-password retirement. Leave false until one test account has reset.
# Then set true and run: php artisan config:clear  (or config:cache)
# See docs/go-live-checklist.md. Deploy does not change passwords.
NUVRA_RETIRE_SHARED_PASSWORDS=false

# Admin forced password change. Off by default so a UAT deploy does not
# make the current admin change password. Turn it on for production
# promotion, then change the admin password. See docs/go-live-checklist.md.
NUVRA_FORCE_ADMIN_PASSWORD_CHANGE=false

# Admin screen for flagged test players. Off by default. Ignored when
# APP_ENV=production. Turn it off again after QA. See docs/go-live-checklist.md.
QA_TOOLS_ENABLED=false

# Player workbook (names, phones, birth dates). Keep the file outside this
# repo. Example: /var/nuvra/masterbase.xlsx
# Seeders refuse to run when this is empty or points inside the repository.
NUVRA_MASTERBASE_PATH=

# UAT site gate. The gate stays off unless BOTH values are non-empty.
# Production should leave both empty. See docs/go-live-checklist.md.
# If config is cached, apply .env edits with: php artisan config:clear
# or rebuild the cache with: php artisan config:cache
UAT_BASIC_AUTH_USER=
UAT_BASIC_AUTH_PASS=
# Signed gate cookie lifetime in minutes. Default 8 hours.
UAT_BASIC_AUTH_MINUTES=480

# Shown when a player needs an activation code. Leave empty for the neutral
# sentence. Example shape only: a WhatsApp number or an admin's name.
NUVRA_ACTIVATION_CONTACT=

# Comma-separated proxy CIDRs. Empty uses Cloudflare's published ranges.
# "*" is ignored. See docs/go-live-checklist.md.
NUVRA_TRUSTED_PROXIES=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
